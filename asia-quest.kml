<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Asia Quest 14–25 Nov 2026</name>
    <Folder><name>Shanghai 14–15 Nov</name>
      <Placemark><name>Shanghai Pudong Airport (PVG), Terminal 2</name><description>[BOOKED · airport]</description><Point><coordinates>121.8045,31.1504,0</coordinates></Point></Placemark>
      <Placemark><name>INS New Paradise (Fuxing Park)</name><description>[YOUR PICK · sight] Your pick. 6 floors of clubs and bars at 109 Yandang Rd (雁荡路109号), inside Fuxing Park. Park gates shut at 21:00, so go in on the Yandang Rd side.</description><Point><coordinates>121.4703,31.2187,0</coordinates></Point></Placemark>
      <Placemark><name>Xintiandi &amp; Sinan Mansions night walk</name><description>[IDEA · sight] Next door to INS. Quiet, lit-up old shikumen lanes after the clubs.</description><Point><coordinates>121.4749,31.2196,0</coordinates></Point></Placemark>
      <Placemark><name>The Bund at dawn</name><description>[IDEA · sight] Pudong skyline across the river. First light around 06:00.</description><Point><coordinates>121.4903,31.24,0</coordinates></Point></Placemark>
      <Placemark><name>Late-night food near Xintiandi</name><description>[IDEA · food] Soup dumplings or noodles to refuel before the airport run.</description><Point><coordinates>121.477,31.2165,0</coordinates></Point></Placemark>
      <Placemark><name>Nanjing Road pedestrian street</name><description>[IDEA · shop] Neon shopping street, lit up late. Good stroll on the all-nighter.</description><Point><coordinates>121.4782,31.2353,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>Taipei 15–18 Nov</name>
      <Placemark><name>Taoyuan Airport (TPE), Terminal 1</name><description>[BOOKED · airport]</description><Point><coordinates>121.2328,25.0777,0</coordinates></Point></Placemark>
      <Placemark><name>Hanns House</name><description>[BOOKED · hotel] 15→18 Nov · Premier Room, 101 view · booking 1653717920347246 · check-in 15:00, out 12:00 · 10 min walk to Taipei 101 · +886 2 8758 3777</description><Point><coordinates>121.5636,25.0405,0</coordinates></Point></Placemark>
      <Placemark><name>Taipei Main Station</name><description>[IDEA · transit] Airport MRT from Taoyuan (about 40 min) and the high-speed rail to Kaohsiung both start here.</description><Point><coordinates>121.517,25.0478,0</coordinates></Point></Placemark>
      <Placemark><name>Ximending</name><description>[IDEA · sight]</description><Point><coordinates>121.5068,25.0422,0</coordinates></Point></Placemark>
      <Placemark><name>Taipei 101 Observatory</name><description>[IDEA · sight]</description><Point><coordinates>121.5645,25.0339,0</coordinates></Point></Placemark>
      <Placemark><name>Elephant Mountain trail</name><description>[IDEA · sight] Short steep climb; best view of 101 at sunset (around 17:05 in late November).</description><Point><coordinates>121.5706,25.0273,0</coordinates></Point></Placemark>
      <Placemark><name>Raohe Night Market</name><description>[IDEA · food]</description><Point><coordinates>121.5775,25.0509,0</coordinates></Point></Placemark>
      <Placemark><name>Longshan Temple</name><description>[IDEA · sight]</description><Point><coordinates>121.4999,25.0372,0</coordinates></Point></Placemark>
      <Placemark><name>Chiang Kai-shek Memorial Hall</name><description>[IDEA · sight]</description><Point><coordinates>121.5219,25.0346,0</coordinates></Point></Placemark>
      <Placemark><name>Din Tai Fung (Xinyi Rd)</name><description>[IDEA · food] The original branch, on Yongkang Street's corner. Take a queue number, then wander.</description><Point><coordinates>121.53,25.0334,0</coordinates></Point></Placemark>
      <Placemark><name>Songshan Ciyou Temple</name><description>[IDEA · sight] Ornate Mazu temple right at the Raohe night market gate.</description><Point><coordinates>121.5779,25.051,0</coordinates></Point></Placemark>
      <Placemark><name>Sun Yat-sen Memorial Hall</name><description>[IDEA · sight] 3 min walk from Hanns House. Changing of the guard on the hour.</description><Point><coordinates>121.5602,25.04,0</coordinates></Point></Placemark>
      <Placemark><name>Din Tai Fung (Taipei 101, B1)</name><description>[IDEA · food] Soup dumplings under the tower. Take a queue number, then shop.</description><Point><coordinates>121.565,25.0336,0</coordinates></Point></Placemark>
      <Placemark><name>Fuzhou pepper buns (Raohe gate)</name><description>[IDEA · food] Michelin Bib Gourmand stall at the market entrance. Expect a queue.</description><Point><coordinates>121.5772,25.0508,0</coordinates></Point></Placemark>
      <Placemark><name>Bopiliao Historic Block</name><description>[IDEA · sight] Qing-era brick street, 3 min from Longshan Temple.</description><Point><coordinates>121.5019,25.0367,0</coordinates></Point></Placemark>
      <Placemark><name>Yong Kang Beef Noodle</name><description>[IDEA · food] Classic braised beef noodle soup near Yongkang Street.</description><Point><coordinates>121.5293,25.0322,0</coordinates></Point></Placemark>
      <Placemark><name>Ay-Chung Flour-Rice Noodle</name><description>[IDEA · food] Standing-only bowls of oyster mee sua in Ximending.</description><Point><coordinates>121.5076,25.0438,0</coordinates></Point></Placemark>
      <Placemark><name>Taipei Zoo · Giant Panda House</name><description>[YOUR PICK · sight] Your pick. Open 9:00–17:00, last entry 16:00. Go at opening: pandas are most active in the morning. MRT Brown line to Taipei Zoo.</description><Point><coordinates>121.581,24.9983,0</coordinates></Point></Placemark>
      <Placemark><name>Maokong Gondola (Taipei Zoo Station)</name><description>[IDEA · transit] Cable car from the zoo up to Maokong's tea houses. Closed Mondays.</description><Point><coordinates>121.5768,24.996,0</coordinates></Point></Placemark>
      <Placemark><name>Maokong tea houses</name><description>[IDEA · food] Oolong tea with a view over Taipei, at the top of the gondola.</description><Point><coordinates>121.588,24.969,0</coordinates></Point></Placemark>
      <Placemark><name>EasyCard design store, Ximending</name><description>[YOUR PICK · shop] Get your EasyCard here, not at the airport: the designs are much nicer.</description><Point><coordinates>121.507,25.044,0</coordinates></Point></Placemark>
      <Placemark><name>Hello Kitty 7-Eleven</name><description>[YOUR PICK · shop] Themed 7-Eleven, 73 Hankou St Sec 2. A 5 min walk from Ximending.</description><Point><coordinates>121.5063,25.0459,0</coordinates></Point></Placemark>
      <Placemark><name>Peanuts (Snoopy) 7-Eleven</name><description>[YOUR PICK · shop] Themed 7-Eleven, 37 Shaoxing N St. 3 min from Fu Hang Soy Milk.</description><Point><coordinates>121.5262,25.0452,0</coordinates></Point></Placemark>
      <Placemark><name>Sumikko Gurashi 7-Eleven</name><description>[YOUR PICK · shop] Themed 7-Eleven, 271 Chang'an W Rd. Near Taipei Main Station.</description><Point><coordinates>121.512,25.05,0</coordinates></Point></Placemark>
      <Placemark><name>Mickey Mouse 7-Eleven</name><description>[YOUR PICK · shop] Themed 7-Eleven, 20-2 Bade Rd Sec 3. On the way east to Raohe.</description><Point><coordinates>121.5512,25.0479,0</coordinates></Point></Placemark>
      <Placemark><name>Lao Shandong Beef Noodles</name><description>[YOUR PICK · food] Michelin Bib Gourmand beef noodles in Ximending. Cash only.</description><Point><coordinates>121.5072,25.0435,0</coordinates></Point></Placemark>
      <Placemark><name>Fu Hang Soy Milk</name><description>[YOUR PICK · food] Michelin Bib breakfast, 2F of Huashan Market. Order No. 24: shaobing with egg &amp; youtiao (75 NTD). Expect a queue; closes around 12:30.</description><Point><coordinates>121.5255,25.0443,0</coordinates></Point></Placemark>
      <Placemark><name>Su Lai Chuan</name><description>[YOUR PICK · food] Since 1946. Ba-wan and taro cake, Michelin Bib. Walk-in, 5 min from Longshan Temple.</description><Point><coordinates>121.5004,25.0338,0</coordinates></Point></Placemark>
      <Placemark><name>Fujin Tree Taiwanese Cuisine &amp; Champagne (Songshan)</name><description>[YOUR PICK · food] One Michelin star, modern Taiwanese. Needs a booking; weekday lunch is the easiest table.</description><Point><coordinates>121.5492,25.0598,0</coordinates></Point></Placemark>
      <Placemark><name>Chia Te Bakery (pineapple cakes)</name><description>[IDEA · shop] Taipei's most famous pineapple cakes. Queue moves fast; 15 min walk to Raohe.</description><Point><coordinates>121.5605,25.051,0</coordinates></Point></Placemark>
      <Placemark><name>Huashan 1914 Creative Park</name><description>[IDEA · shop] Old winery turned design shops and pop-up markets. 5 min from Fu Hang Soy Milk.</description><Point><coordinates>121.5294,25.0441,0</coordinates></Point></Placemark>
      <Placemark><name>Carrefour Guilin (24 h hypermarket)</name><description>[IDEA · shop] Open 24 h, 5 min from Longshan Temple. Best for a snack and souvenir haul at supermarket prices.</description><Point><coordinates>121.5028,25.0367,0</coordinates></Point></Placemark>
      <Placemark><name>Dihua Street</name><description>[IDEA · shop] Old street of dried goods, tea, fabric and little design shops.</description><Point><coordinates>121.51,25.0558,0</coordinates></Point></Placemark>
      <Placemark><name>Tian Cai Japanese Restaurant (添財)</name><description>[IDEA · food] Tip from a Taipei local. Old-school Japanese with lots of Taipei history; close to Dadaocheng.</description><Point><coordinates>121.5135,25.0475,0</coordinates></Point></Placemark>
      <Placemark><name>Shin Yeh Taiwanese Cuisine (original branch)</name><description>[IDEA · food] Tip from a Taipei local. Classic traditional Taiwanese dishes in a comfortable setting. 34-1 Shuangcheng St.</description><Point><coordinates>121.524,25.064,0</coordinates></Point></Placemark>
      <Placemark><name>Chi Jia Zhuang (雞家莊)</name><description>[IDEA · food] Tip from a Taipei local. Long-established chicken house, very local. 55 Changchun Rd.</description><Point><coordinates>121.5265,25.0545,0</coordinates></Point></Placemark>
      <Placemark><name>Buffalo American Charbroil Steakhouse</name><description>[IDEA · food] Tip from a Taipei local. Long-time local favourite, good value. Near Guting MRT.</description><Point><coordinates>121.521,25.028,0</coordinates></Point></Placemark>
      <Placemark><name>Wagyu Shabu (和牛涮, all-you-can-eat)</name><description>[IDEA · food] Tip from a Taipei local. All-you-can-eat wagyu hot pot: Taiwan loves hot pot. 128 Zhongxiao E Rd Sec 4, 2F.</description><Point><coordinates>121.547,25.0415,0</coordinates></Point></Placemark>
      <Placemark><name>Gobi Mongolian BBQ (大戈壁)</name><description>[IDEA · food] Tip from a Taipei local. Decades-old, uniquely Taiwanese "Mongolian" BBQ: pick your meat and veg, chefs stir-fry it. 152 Songjiang Rd, 3F (another branch in Ximending).</description><Point><coordinates>121.533,25.0535,0</coordinates></Point></Placemark>
      <Placemark><name>Longmen Restaurant (龍門客棧), Maokong</name><description>[IDEA · food] Tip from a Taipei local. Roast chicken with a view over Taipei; 5 min walk from Maokong gondola station.</description><Point><coordinates>121.588,24.968,0</coordinates></Point></Placemark>
      <Placemark><name>Dadaocheng (old Taipei)</name><description>[IDEA · sight] Tip from a Taipei local. One of the oldest parts of the city: vintage shops, tea houses, cafés. Best enjoyed by just wandering. Go on a weekday.</description><Point><coordinates>121.5095,25.056,0</coordinates></Point></Placemark>
      <Placemark><name>Simple Kaffa Sola (Taipei 101, 88F)</name><description>[IDEA · food] From the MiTaiMu video. Café by a world barista champion, high up in Taipei 101 with a city view.</description><Point><coordinates>121.5648,25.0336,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>Tainan 18 Nov</name>
      <Placemark><name>Tainan HSR station</name><description>[YOUR PICK · transit] Change to the shuttle train (Shalun line) into the city, about 25 min.</description><Point><coordinates>120.2856,22.925,0</coordinates></Point></Placemark>
      <Placemark><name>Tainan Railway Station</name><description>[YOUR PICK · transit] Trains to Kaohsiung every ~15 min, about 35–45 min.</description><Point><coordinates>120.2128,22.9971,0</coordinates></Point></Placemark>
      <Placemark><name>Qiu Jia Squid Vermicelli</name><description>[YOUR PICK · food] Squid rice noodle soup, 120 TWD. A morning-to-lunch shop, so check it is still open.</description><Point><coordinates>120.1975,22.9935,0</coordinates></Point></Placemark>
      <Placemark><name>Lo Cheng Migao</name><description>[YOUR PICK · food] Michelin Bib. Sticky rice with braised pork, 60 TWD. Cash only; sells out by afternoon. Michelin lists it closed on Wednesdays, so check.</description><Point><coordinates>120.1985,22.993,0</coordinates></Point></Placemark>
      <Placemark><name>Yuan Zai Hui shaved ice</name><description>[YOUR PICK · food] Michelin Bib eight-treasure shaved ice, 60 TWD. Pick your toppings.</description><Point><coordinates>120.1965,22.992,0</coordinates></Point></Placemark>
      <Placemark><name>A Sha Restaurant (main branch)</name><description>[YOUR PICK · food] Since 1940. Tainan banquet classics, famous red-crab sticky rice. Sit-down; book ahead.</description><Point><coordinates>120.203,22.989,0</coordinates></Point></Placemark>
      <Placemark><name>A Hsing Congee</name><description>[YOUR PICK · food] Milkfish congee since 1965, 95 TWD. Queue from 5 am, sells out before noon. Cash only.</description><Point><coordinates>120.196,22.994,0</coordinates></Point></Placemark>
      <Placemark><name>Hayashi Department Store (Lin)</name><description>[IDEA · shop] 1932 department store full of local brands, with a rooftop shrine. 10 min from the food crawl.</description><Point><coordinates>120.203,22.9917,0</coordinates></Point></Placemark>
      <Placemark><name>Win Chang Beef Soup, Anping main shop</name><description>[IDEA · food] From the MiTaiMu video. Tainan-style fresh beef soup. 15 min taxi from the food crawl; check hours, beef-soup shops often close mid-afternoon.</description><Point><coordinates>120.166,22.9985,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>Kaohsiung 18–19 Nov</name>
      <Placemark><name>HSR Zuoying Station</name><description>[IDEA · transit] High-speed rail from Taipei Main Station takes about 1h35.</description><Point><coordinates>120.3081,22.6873,0</coordinates></Point></Placemark>
      <Placemark><name>Just Inn Kaohsiung</name><description>[BOOKED · hotel] 18→19 Nov · Just Inn Suite · booking 1653718041333529 · check-in 15:00, out 11:00 · 8 min walk to Liuhe Night Market</description><Point><coordinates>120.2936,22.6338,0</coordinates></Point></Placemark>
      <Placemark><name>Lotus Pond, Dragon &amp; Tiger Pagodas</name><description>[IDEA · sight]</description><Point><coordinates>120.2944,22.6804,0</coordinates></Point></Placemark>
      <Placemark><name>Formosa Boulevard Station (Dome of Light)</name><description>[IDEA · sight]</description><Point><coordinates>120.302,22.6315,0</coordinates></Point></Placemark>
      <Placemark><name>Liuhe Night Market</name><description>[IDEA · food]</description><Point><coordinates>120.2995,22.6325,0</coordinates></Point></Placemark>
      <Placemark><name>Pier-2 Art Center</name><description>[IDEA · sight]</description><Point><coordinates>120.2817,22.62,0</coordinates></Point></Placemark>
      <Placemark><name>Kaohsiung Main Station (TRA)</name><description>[IDEA · transit] Express trains to Chiayi take about 1h–1h20.</description><Point><coordinates>120.3022,22.639,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>Alishan 19 Nov</name>
      <Placemark><name>Chiayi Station (Alishan Forest Railway)</name><description>[BOOKED · transit] Forest railway platform is inside the TRA station.</description><Point><coordinates>120.4412,23.4791,0</coordinates></Point></Placemark>
      <Placemark><name>Shizilu Station</name><description>[BOOKED · transit] End of the line, 1,534 m up. About 30 min by road to the forest park.</description><Point><coordinates>120.75475,23.49275,0</coordinates></Point></Placemark>
      <Placemark><name>Alishan National Forest Recreation Area</name><description>[YOUR PICK · sight] Giant cypresses, Sister Ponds, sunrise at Zhushan.</description><Point><coordinates>120.803,23.5106,0</coordinates></Point></Placemark>
      <Placemark><name>Chiayi HSR Station</name><description>[IDEA · transit] Alishan bus 7329 ends here; high-speed rail north to Taichung takes about 30 min.</description><Point><coordinates>120.3237,23.4593,0</coordinates></Point></Placemark>
      <Placemark><name>Sun Link Sea (Shanlinxi) Forest</name><description>[YOUR PICK · sight] Waterfalls and forest at 1,600 m. Hydrangeas bloom May–June, so expect autumn maples instead. About 3 h by bus 6883B from Taichung, so it needs its own day.</description><Point><coordinates>120.79,23.637,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>Taichung 19–20 Nov</name>
      <Placemark><name>Taichung HSR Station</name><description>[IDEA · transit]</description><Point><coordinates>120.6157,24.1121,0</coordinates></Point></Placemark>
      <Placemark><name>Fengjia Night Market</name><description>[IDEA · food] Taiwan's biggest night market, open late. Good for a late dinner after the trip down from Alishan.</description><Point><coordinates>120.6464,24.1752,0</coordinates></Point></Placemark>
      <Placemark><name>Miyahara (ice cream &amp; sweets)</name><description>[IDEA · food] 1920s eye clinic turned ice cream parlour, by Taichung Station.</description><Point><coordinates>120.6835,24.1375,0</coordinates></Point></Placemark>
      <Placemark><name>Kung Fu Shanghai Fish Ball</name><description>[YOUR PICK · food] Michelin Bib. Scallion oil noodles and chilli oil dumplings. Check opening hours.</description><Point><coordinates>120.662,24.15,0</coordinates></Point></Placemark>
      <Placemark><name>Ming Juan Lou (InterContinental)</name><description>[YOUR PICK · food] Michelin-listed Cantonese, roast duck. Closed Mon &amp; Tue, so Thursday works. Book ahead.</description><Point><coordinates>120.6625,24.1515,0</coordinates></Point></Placemark>
      <Placemark><name>Yu Yue Lou</name><description>[YOUR PICK · food] Michelin-listed modern Cantonese with a Hong Kong kitchen team.</description><Point><coordinates>120.644,24.1505,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>North Taiwan 20–22 Nov</name>
      <Placemark><name>Jiufen Old Street</name><description>[YOUR PICK · sight] Your pick. Lantern-lit old street on the hill; best at dusk. Bus 1062 from Zhongxiao Fuxing in Taipei, about 1 hour.</description><Point><coordinates>121.8448,25.1092,0</coordinates></Point></Placemark>
      <Placemark><name>Hsinchu HSR Station</name><description>[IDEA · transit] About 25 min from Taichung. Taxi to the museum about 15 min.</description><Point><coordinates>121.0405,24.8081,0</coordinates></Point></Placemark>
      <Placemark><name>TSMC Museum of Innovation</name><description>[BOOKED · sight] BOOKED: Tue 17 Nov, 13:30, audio-guide tour, 3 people. Questions: +886-3-5636968.</description><Point><coordinates>121.0135,24.774,0</coordinates></Point></Placemark>
      <Placemark><name>A-Gan Yi taro balls (Jiufen)</name><description>[IDEA · food] Taro ball dessert with a view over the bay.</description><Point><coordinates>121.8437,25.1083,0</coordinates></Point></Placemark>
      <Placemark><name>Beitou Hot Spring Museum</name><description>[IDEA · sight]</description><Point><coordinates>121.5079,25.1366,0</coordinates></Point></Placemark>
      <Placemark><name>Onsen Papawaqa (Tai'an hot spring, Miaoli)</name><description>[BOOKED · hotel] 21→22 Nov · 2 adults · your hot-spring night. Rooms with private hot-spring tubs. 58 Yuandun, Jinshui Village, Tai'an. Phone +886-3-7941777. Shuttle from Miaoli HSR station; trip.com guests say it is paid for them, so ask the hotel.</description><Point><coordinates>120.996,24.443,0</coordinates></Point></Placemark>
      <Placemark><name>Hao Peng You (Good Friend) Cold Noodles</name><description>[YOUR PICK · food] Michelin Bib cold sesame noodles, about 65 TWD. Shilin Night Market, red MRT line.</description><Point><coordinates>121.5245,25.088,0</coordinates></Point></Placemark>
      <Placemark><name>Shi Yang (Xizhi)</name><description>[YOUR PICK · food] Michelin-listed wabi-sabi omakase in the hills. Taxi only. Book ahead.</description><Point><coordinates>121.648,25.095,0</coordinates></Point></Placemark>
      <Placemark><name>Tamsui Fisherman's Wharf</name><description>[YOUR PICK · sight] Sunset over the river mouth, around 17:00 in late November. End of the red MRT line.</description><Point><coordinates>121.411,25.183,0</coordinates></Point></Placemark>
      <Placemark><name>Miaoli HSR station</name><description>[BOOKED · transit] Hotel shuttle to Onsen Papawaqa from here (book a time with the hotel).</description><Point><coordinates>120.8255,24.6056,0</coordinates></Point></Placemark>
      <Placemark><name>Nangang HSR station</name><description>[BOOKED · transit] First HSR stop, 15 min by taxi from Xizhi.</description><Point><coordinates>121.6066,25.0522,0</coordinates></Point></Placemark>
      <Placemark><name>Shifen Old Street (sky lanterns)</name><description>[IDEA · sight] From the MiTaiMu video. Write wishes on a sky lantern and launch it over the railway track. 30 min from Jiufen.</description><Point><coordinates>121.7756,25.0425,0</coordinates></Point></Placemark>
      <Placemark><name>Keelung Miaokou Night Market</name><description>[IDEA · food] From the MiTaiMu video. Harbour-town night market, 40 min from Jiufen by bus.</description><Point><coordinates>121.743,25.1283,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>Tokyo 22–24 Nov</name>
      <Placemark><name>Narita Airport (NRT), Terminal 2</name><description>[BOOKED · airport]</description><Point><coordinates>140.3864,35.7647,0</coordinates></Point></Placemark>
      <Placemark><name>Hotel Grand Arc Hanzomon</name><description>[BOOKED · hotel] 22→23 Nov · check-in 14:00, out 10:00 · booking 1653718122516266 · free cancel until 21 Nov 23:59 · +81 3 3288 0111</description><Point><coordinates>139.7434,35.682991,0</coordinates></Point></Placemark>
      <Placemark><name>Chidorigafuchi moat walk</name><description>[IDEA · sight] 5 min from the hotel. Easy morning walk before check-out.</description><Point><coordinates>139.7447,35.6915,0</coordinates></Point></Placemark>
      <Placemark><name>Tsukiji Outer Market</name><description>[IDEA · food]</description><Point><coordinates>139.7707,35.6654,0</coordinates></Point></Placemark>
      <Placemark><name>Senso-ji, Asakusa</name><description>[IDEA · sight]</description><Point><coordinates>139.7967,35.7148,0</coordinates></Point></Placemark>
      <Placemark><name>Shibuya Crossing</name><description>[IDEA · sight]</description><Point><coordinates>139.7005,35.6595,0</coordinates></Point></Placemark>
      <Placemark><name>Tokyu Stay Kamata – Tokyo Haneda</name><description>[BOOKED · hotel] 23→24 Nov · check-in 15:00, out 11:00 · booking 1653718122460473 · free cancel until 22 Nov 23:59 · +81 3 5714 1090</description><Point><coordinates>139.721514,35.560824,0</coordinates></Point></Placemark>
      <Placemark><name>Kamata gyoza (Nihao)</name><description>[IDEA · food] Kamata is famous for crispy-winged gyoza. Early dinner, early bed.</description><Point><coordinates>139.7155,35.5615,0</coordinates></Point></Placemark>
      <Placemark><name>Haneda Airport (HND), Terminal 3</name><description>[BOOKED · airport]</description><Point><coordinates>139.7684,35.544,0</coordinates></Point></Placemark>
      <Placemark><name>Nakamise-dori</name><description>[IDEA · shop] The souvenir lane leading to Senso-ji.</description><Point><coordinates>139.7965,35.7116,0</coordinates></Point></Placemark>
      <Placemark><name>Don Quijote Shibuya (MEGA)</name><description>[IDEA · shop] Chaotic discount megastore, open 24 h. Tax-free with your passport.</description><Point><coordinates>139.6976,35.6614,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>Hong Kong 24–25 Nov</name>
